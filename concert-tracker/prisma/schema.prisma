// Prisma schema for MySQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Artist {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  mbid      String?   @db.VarChar(255)
  imageUrl  String?   @db.VarChar(500)
  createdAt Int       @default(0)
  updatedAt Int       @default(0)
  
  concerts  Concert[]
  userStats UserArtist[]
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100) // Full country name: "Turkey", "France"
  code      String    @unique @db.VarChar(10)  // ISO country code: "tr", "fr"
  createdAt Int
  updatedAt Int

  concerts     Concert[]
  cityMappings CityMapping[]
  userActiveCountries UserActiveCountry[]

  @@index([code])
  @@index([name])
}

model CityMapping {
  id             Int      @id @default(autoincrement())
  originalCity   String   @db.VarChar(255)
  countryId      Int      // Foreign key (now required)
  countryObj     Country  @relation(fields: [countryId], references: [id])
  normalizedCity String   @db.VarChar(255)
  latitude       String?  @db.VarChar(50)
  longitude      String?  @db.VarChar(50)
  source         String   @db.VarChar(50) // 'manual' | 'geocoded' | 'text_normalized'
  createdAt      Int
  updatedAt      Int

  @@unique([originalCity, countryId])
  @@index([normalizedCity, countryId])
  @@index([countryId])
}

model Concert {
  id             Int     @id @default(autoincrement())
  eventName      String  @db.VarChar(500)
  eventUrl       String  @unique @db.VarChar(500)
  dateStart      Int     // Unix timestamp (seconds since epoch)
  dateEnd        Int     // Unix timestamp (seconds since epoch)
  venue          String  @db.VarChar(500)
  city           String   @db.VarChar(255) // Original city name
  normalizedCity String   @db.VarChar(255) // Normalized city name for grouping
  countryId      Int      // Foreign key (now required)
  countryObj     Country  @relation(fields: [countryId], references: [id])
  postalCode     String?  @db.VarChar(20)
  performers   String  @db.Text // JSON array stored as text
  imageUrl     String? @db.VarChar(500)
  organizer    String? @db.VarChar(255)
  organizerUrl String? @db.VarChar(500)
  ticketLinks  String  @db.Text // JSON array stored as text
  artistId     Int
  artist       Artist  @relation(fields: [artistId], references: [id])
  createdAt    Int     // Unix timestamp
  updatedAt    Int     // Unix timestamp

  userInteractions UserConcert[]

  @@index([artistId])
  @@index([city])
  @@index([normalizedCity])
  @@index([countryId])
  @@index([dateStart])
  @@index([eventUrl])
}

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(100)
  value       String  @db.Text
  valueType   String  @db.VarChar(20)  // 'string' | 'int' | 'bool' | 'json'
  description String? @db.Text
  createdAt   Int
  updatedAt   Int

  @@index([key])
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique @db.VarChar(100)
  hashedPassword String    @db.VarChar(255)
  role           Role      @default(USER)
  createdAt      Int
  updatedAt      Int

  settings        UserSetting[]
  concerts        UserConcert[]
  artists         UserArtist[]
  activeCountries UserActiveCountry[]
  auditLogs       SettingAuditLog[]
}

model UserSetting {
  id        Int    @id @default(autoincrement())
  userId    Int
  key       String  @db.VarChar(100)
  value     String  @db.Text
  valueType String  @db.VarChar(20)
  createdAt Int
  updatedAt Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
}

model UserConcert {
  id         Int     @id @default(autoincrement())
  userId     Int
  concertId  Int
  interested Boolean @default(false)
  notes      String? @db.Text
  createdAt  Int
  updatedAt  Int

  user    User    @relation(fields: [userId], references: [id])
  concert Concert @relation(fields: [concertId], references: [id])

  @@unique([userId, concertId])
  @@index([userId])
  @@index([concertId])
}

model UserArtist {
  id               Int     @id @default(autoincrement())
  userId           Int
  artistId         Int
  playcount        Int     @default(0)
  playcount12month Int     @default(0)
  recent           Boolean @default(false)
  createdAt        Int
  updatedAt        Int

  user   User   @relation(fields: [userId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model UserActiveCountry {
  id        Int @id @default(autoincrement())
  userId    Int
  countryId Int
  createdAt Int

  user    User    @relation(fields: [userId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([userId, countryId])
  @@index([userId])
  @@index([countryId])
}

model SettingAuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int
  key       String  @db.VarChar(100)
  oldValue  String? @db.Text
  newValue  String  @db.Text
  createdAt Int

  user User @relation(fields: [userId], references: [id])

  @@index([key])
  @@index([userId])
}
