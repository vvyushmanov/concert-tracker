// Prisma schema for MySQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
}

// Lifecycle of one ingest batch (a page's worth of scraped concerts) in the
// durable async-delivery queue. See model IngestBatch.
enum IngestBatchStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model Artist {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  mbid      String?   @db.VarChar(255)
  // Unix ts of the most recent MBID lookup that found NOTHING (MusicBrainz +
  // Last.fm). null = never looked up. Lets the metadata pass skip artists it has
  // already failed to resolve instead of re-querying the whole no-MBID backlog
  // every crawl; they're retried only after a recheck window (MusicBrainz grows).
  mbidCheckedAt Int?
  imageUrl  String?   @db.VarChar(500)
  // Unix ts of the most recent fanart.tv image lookup that found NOTHING. Mirror
  // of mbidCheckedAt for images: lets the metadata pass skip the huge "has MBID
  // but no image" backlog instead of re-querying fanart.tv for the same imageless
  // acts every crawl; they're retried only after a recheck window.
  imageCheckedAt Int?
  createdAt Int       @default(0)
  updatedAt Int       @default(0)
  
  concerts  ArtistConcert[]  // Many-to-many through junction
  userStats UserArtist[]
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100) // Full country name: "Turkey", "France"
  code      String    @unique @db.VarChar(10)  // ISO country code: "tr", "fr"
  active    Boolean   @default(true)           // Global admin setting - inactive countries can still be active per-user
  createdAt Int
  updatedAt Int

  concerts         Concert[]
  cityMappings     CityMapping[]
  normalizedCities CityNormalized[]
  userActiveCountries UserActiveCountry[]

  @@index([code])
  @@index([name])
  @@index([active])
}

model CityNormalized {
  id             Int      @id @default(autoincrement())
  normalizedCity String   @db.VarChar(255)
  countryId      Int
  country        Country  @relation(fields: [countryId], references: [id])
  createdAt      Int
  updatedAt      Int

  cityMappings   CityMapping[]

  @@unique([normalizedCity, countryId])
  @@index([countryId])
}

model CityMapping {
  id               Int              @id @default(autoincrement())
  originalCity     String           @db.VarChar(255)
  countryId        Int              // Foreign key (now required)
  countryObj       Country          @relation(fields: [countryId], references: [id])
  cityNormalizedId Int              // FK to CityNormalized
  cityNormalized   CityNormalized   @relation(fields: [cityNormalizedId], references: [id])
  latitude         Float?
  longitude        Float?
  // Unix ts of the most recent geocode attempt that found NOTHING (a clean
  // Nominatim "no match" — NOT a rate-limit miss, which stays retryable). Mirror
  // of mbidCheckedAt/imageCheckedAt: stops the backfill from re-geocoding cities
  // Nominatim can't resolve on every pass; retried only after a recheck window.
  coordsCheckedAt  Int?
  source           String           @db.VarChar(50) // 'manual' | 'geocoded' | 'text_normalized'
  createdAt        Int
  updatedAt        Int

  concerts         Concert[]

  @@unique([originalCity, countryId])
  @@index([countryId])
  @@index([cityNormalizedId])
}

model Concert {
  id             Int           @id @default(autoincrement())
  eventName      String        @db.VarChar(500)
  eventUrl       String        @unique @db.VarChar(500)
  dateStart      Int           // Unix timestamp (seconds since epoch)
  dateEnd        Int           // Unix timestamp (seconds since epoch)
  venue          String        @db.VarChar(500)
  cityMappingId  Int           // FK to CityMapping
  cityMapping    CityMapping   @relation(fields: [cityMappingId], references: [id])
  countryId      Int           // Foreign key (now required)
  countryObj     Country       @relation(fields: [countryId], references: [id])
  postalCode     String?       @db.VarChar(20)
  performers     String        @db.Text // JSON array stored as text
  imageUrl       String?       @db.VarChar(500)
  organizer      String?       @db.VarChar(255)
  organizerUrl   String?       @db.VarChar(500)
  ticketLinks    String        @db.Text // JSON array stored as text
  createdAt      Int           // Unix timestamp
  updatedAt      Int           // Unix timestamp

  artists          ArtistConcert[]  // Many-to-many through junction
  userInteractions UserConcert[]

  @@index([countryId])
  @@index([dateStart])
  @@index([eventUrl])
  @@index([cityMappingId])
  @@index([countryId, dateStart])
}

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique @db.VarChar(100)
  value       String  @db.Text
  valueType   String  @db.VarChar(20)  // 'string' | 'int' | 'bool' | 'json'
  description String? @db.Text
  createdAt   Int
  updatedAt   Int

  @@index([key])
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique @db.VarChar(100)
  hashedPassword String    @db.VarChar(255)
  role           Role      @default(USER)
  createdAt      Int
  updatedAt      Int

  settings        UserSetting[]
  concerts        UserConcert[]
  artists         UserArtist[]
  activeCountries UserActiveCountry[]
  auditLogs       SettingAuditLog[]
  friendships     Friendship[]      @relation("UserFriendships")
  friendOf        Friendship[]      @relation("FriendFriendships")
  notifications   Notification[]    @relation("UserNotifications")
  notificationsSent Notification[]  @relation("NotificationsFrom")
}

model UserSetting {
  id        Int    @id @default(autoincrement())
  userId    Int
  key       String  @db.VarChar(100)
  value     String  @db.Text
  valueType String  @db.VarChar(20)
  createdAt Int
  updatedAt Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model UserConcert {
  id         Int     @id @default(autoincrement())
  userId     Int
  concertId  Int
  interested Boolean @default(false)
  notes      String? @db.Text
  isPrivate  Boolean @default(false)
  createdAt  Int
  updatedAt  Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concert Concert @relation(fields: [concertId], references: [id])

  @@unique([userId, concertId])
  @@index([userId])
  @@index([concertId])
  @@index([isPrivate])
  @@index([interested])
  @@index([userId, interested])
}

model UserArtist {
  id               Int     @id @default(autoincrement())
  userId           Int
  artistId         Int
  playcount        Int     @default(0)
  playcount12month Int     @default(0)
  recent           Boolean @default(false)
  createdAt        Int
  updatedAt        Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
  @@index([userId, playcount])
}

model UserActiveCountry {
  id        Int @id @default(autoincrement())
  userId    Int
  countryId Int
  createdAt Int @default(0)
  updatedAt Int @default(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id])

  @@unique([userId, countryId])
  @@index([userId])
  @@index([countryId])
}

model SettingAuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int
  key       String  @db.VarChar(100)
  oldValue  String? @db.Text
  newValue  String  @db.Text
  createdAt Int @default(0)
  updatedAt Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}

model Friendship {
  id        Int              @id @default(autoincrement())
  userId    Int              // User who sent the request
  friendId  Int              // User who received the request
  status    FriendshipStatus @default(PENDING)
  createdAt Int              // Unix timestamp
  updatedAt Int              // Unix timestamp

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
  @@index([userId, status])
  @@index([friendId, status])
}

model Notification {
  id         Int              @id @default(autoincrement())
  userId     Int              // Recipient of the notification
  type       NotificationType
  fromUserId Int?             // User who triggered the notification
  message    String           @db.Text
  read       Boolean          @default(false)
  createdAt  Int              // Unix timestamp

  user     User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User? @relation("NotificationsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ArtistConcert {
  id        Int     @id @default(autoincrement())
  artistId  Int
  concertId Int
  isPrimary Boolean @default(false)  // True for the headliner/main artist
  createdAt Int @default(0)
  updatedAt Int @default(0)

  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@unique([artistId, concertId])
  @@index([artistId])
  @@index([concertId])
  @@index([isPrimary])
}

// Durable async-ingest queue: the scraper agent POSTs one batch per scraped page
// to /api/ingest, which enqueues a row here and returns 202 immediately. An
// in-process worker drains PENDING rows serially (ingest_json.py per batch),
// decoupling the DB write pace from the HTTP request. Survives a backend
// restart (rows persist); stale PROCESSING rows are reclaimed on boot.
model IngestBatch {
  id         Int               @id @default(autoincrement())
  batchId    String            @unique @db.VarChar(255) // client idempotency key (e.g. "<runId>-fr-p1") — re-POST is a no-op
  status     IngestBatchStatus @default(PENDING)
  received   Int               @default(0)              // # concerts in payload (denormalized for status reads)
  attempts   Int               @default(0)              // worker tries; → ERROR (dead-letter) after the cap
  source     String?           @db.VarChar(255)         // human label, e.g. "fr p1" / runId — observability only
  payload    String            @db.LongText             // JSON array of concert objects (the page's batch)
  result     String?           @db.Text                 // INGEST_RESULT JSON for this batch once DONE
  error      String?           @db.Text                 // last failure detail when status=ERROR
  createdAt  Int                                        // enqueued at (unix seconds)
  startedAt  Int?                                       // claimed (PROCESSING) at
  finishedAt Int?                                       // DONE/ERROR at

  @@index([status])
  @@index([createdAt])
}
