// Prisma schema for SQLite

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DB_PATH")
}

enum Role {
  USER
  ADMIN
}

model Artist {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  playcount       Int       @default(0)
  playcount12month Int      @default(0)
  recent          Boolean   @default(false)
  mbid            String?
  imageUrl        String?
  concerts        Concert[]
  userStats       UserArtist[]
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique // Full country name: "Turkey", "France"
  code      String    @unique // ISO country code: "tr", "fr"
  createdAt Int
  updatedAt Int

  concerts     Concert[]
  cityMappings CityMapping[]
  userActiveCountries UserActiveCountry[]

  @@index([code])
  @@index([name])
}

model CityMapping {
  id             Int      @id @default(autoincrement())
  originalCity   String
  countryId      Int      // Foreign key (now required)
  countryObj     Country  @relation(fields: [countryId], references: [id])
  normalizedCity String
  latitude       String?
  longitude      String?
  source         String  // 'manual' | 'geocoded' | 'text_normalized'
  createdAt      Int
  updatedAt      Int

  @@unique([originalCity, countryId])
  @@index([normalizedCity, countryId])
  @@index([countryId])
}

model Concert {
  id             Int     @id @default(autoincrement())
  eventName      String
  eventUrl       String  @unique
  dateStart      Int     // Unix timestamp (seconds since epoch)
  dateEnd        Int     // Unix timestamp (seconds since epoch)
  venue          String
  city           String   // Original city name
  normalizedCity String   // Normalized city name for grouping
  countryId      Int      // Foreign key (now required)
  countryObj     Country  @relation(fields: [countryId], references: [id])
  postalCode     String?
  performers   String  // JSON array stored as text
  imageUrl     String?
  organizer    String?
  organizerUrl String?
  ticketLinks  String  // JSON array stored as text
  artistId     Int
  artist       Artist  @relation(fields: [artistId], references: [id])
  createdAt    Int     // Unix timestamp
  updatedAt    Int     // Unix timestamp

  userInteractions UserConcert[]

  @@index([artistId])
  @@index([city])
  @@index([normalizedCity])
  @@index([countryId])
  @@index([dateStart])
  @@index([eventUrl])
}

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  valueType   String  // 'string' | 'int' | 'bool' | 'json'
  description String?
  createdAt   Int
  updatedAt   Int

  @@index([key])
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  hashedPassword String
  role           Role      @default(USER)
  createdAt      Int
  updatedAt      Int

  settings        UserSetting[]
  concerts        UserConcert[]
  artists         UserArtist[]
  activeCountries UserActiveCountry[]
  auditLogs       SettingAuditLog[]
}

model UserSetting {
  id        Int    @id @default(autoincrement())
  userId    Int
  key       String
  value     String
  valueType String
  createdAt Int
  updatedAt Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
}

model UserConcert {
  id         Int     @id @default(autoincrement())
  userId     Int
  concertId  Int
  interested Boolean @default(false)
  notes      String?
  createdAt  Int
  updatedAt  Int

  user    User    @relation(fields: [userId], references: [id])
  concert Concert @relation(fields: [concertId], references: [id])

  @@unique([userId, concertId])
  @@index([userId])
  @@index([concertId])
}

model UserArtist {
  id               Int     @id @default(autoincrement())
  userId           Int
  artistId         Int
  playcount        Int     @default(0)
  playcount12month Int     @default(0)
  recent           Boolean @default(false)
  createdAt        Int
  updatedAt        Int

  user   User   @relation(fields: [userId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model UserActiveCountry {
  id        Int @id @default(autoincrement())
  userId    Int
  countryId Int
  createdAt Int

  user    User    @relation(fields: [userId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([userId, countryId])
  @@index([userId])
  @@index([countryId])
}

model SettingAuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int
  key       String
  oldValue  String?
  newValue  String
  createdAt Int

  user User @relation(fields: [userId], references: [id])

  @@index([key])
  @@index([userId])
}
