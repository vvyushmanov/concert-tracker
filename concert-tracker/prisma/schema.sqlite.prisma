// Prisma schema for SQLite

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DB_PATH")
}

enum Role {
  USER
  ADMIN
}

model Artist {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  mbid      String?
  imageUrl  String?
  createdAt Int       @default(0)
  updatedAt Int       @default(0)
  
  concerts  ArtistConcert[]  // Many-to-many through junction
  userStats UserArtist[]
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique // Full country name: "Turkey", "France"
  code      String    @unique // ISO country code: "tr", "fr"
  createdAt Int
  updatedAt Int

  concerts         Concert[]
  cityMappings     CityMapping[]
  normalizedCities CityNormalized[]
  userActiveCountries UserActiveCountry[]

  @@index([code])
  @@index([name])
}

model CityNormalized {
  id             Int      @id @default(autoincrement())
  normalizedCity String
  countryId      Int
  country        Country  @relation(fields: [countryId], references: [id])
  createdAt      Int
  updatedAt      Int

  cityMappings   CityMapping[]

  @@unique([normalizedCity, countryId])
  @@index([countryId])
}

model CityMapping {
  id               Int              @id @default(autoincrement())
  originalCity     String
  countryId        Int              // Foreign key (now required)
  countryObj       Country          @relation(fields: [countryId], references: [id])
  cityNormalizedId Int?             // NEW: FK to CityNormalized (nullable during migration)
  cityNormalized   CityNormalized?  @relation(fields: [cityNormalizedId], references: [id])
  normalizedCity   String           // DEPRECATED: Will be removed after migration
  latitude         String?
  longitude        String?
  source           String           // 'manual' | 'geocoded' | 'text_normalized'
  createdAt        Int
  updatedAt        Int

  concerts         Concert[]

  @@unique([originalCity, countryId])
  @@index([normalizedCity, countryId])
  @@index([countryId])
  @@index([cityNormalizedId])
}

model Concert {
  id             Int           @id @default(autoincrement())
  eventName      String
  eventUrl       String        @unique
  dateStart      Int           // Unix timestamp (seconds since epoch)
  dateEnd        Int           // Unix timestamp (seconds since epoch)
  venue          String
  cityMappingId  Int?          // NEW: FK to CityMapping (nullable during migration)
  cityMapping    CityMapping?  @relation(fields: [cityMappingId], references: [id])
  city           String        // DEPRECATED: Original city name
  normalizedCity String        // DEPRECATED: Normalized city name for grouping
  countryId      Int           // Foreign key (now required)
  countryObj     Country       @relation(fields: [countryId], references: [id])
  postalCode     String?
  performers     String        // JSON array stored as text
  imageUrl       String?
  organizer      String?
  organizerUrl   String?
  ticketLinks    String        // JSON array stored as text
  createdAt      Int           // Unix timestamp
  updatedAt      Int           // Unix timestamp

  artists          ArtistConcert[]  // Many-to-many through junction
  userInteractions UserConcert[]

  @@index([city])
  @@index([normalizedCity])
  @@index([countryId])
  @@index([dateStart])
  @@index([eventUrl])
  @@index([cityMappingId])
}

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  valueType   String  // 'string' | 'int' | 'bool' | 'json'
  description String?
  createdAt   Int
  updatedAt   Int

  @@index([key])
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  hashedPassword String
  role           Role      @default(USER)
  createdAt      Int
  updatedAt      Int

  settings        UserSetting[]
  concerts        UserConcert[]
  artists         UserArtist[]
  activeCountries UserActiveCountry[]
  auditLogs       SettingAuditLog[]
  friendships     Friendship[]      @relation("UserFriendships")
  friendOf        Friendship[]      @relation("FriendFriendships")
  notifications   Notification[]    @relation("UserNotifications")
  notificationsSent Notification[]  @relation("NotificationsFrom")
}

model UserSetting {
  id        Int    @id @default(autoincrement())
  userId    Int
  key       String
  value     String
  valueType String
  createdAt Int
  updatedAt Int

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@index([userId])
}

model UserConcert {
  id         Int     @id @default(autoincrement())
  userId     Int
  concertId  Int
  interested Boolean @default(false)
  notes      String?
  isPrivate  Boolean @default(false)
  createdAt  Int
  updatedAt  Int

  user    User    @relation(fields: [userId], references: [id])
  concert Concert @relation(fields: [concertId], references: [id])

  @@unique([userId, concertId])
  @@index([userId])
  @@index([concertId])
  @@index([isPrivate])
}

model UserArtist {
  id               Int     @id @default(autoincrement())
  userId           Int
  artistId         Int
  playcount        Int     @default(0)
  playcount12month Int     @default(0)
  recent           Boolean @default(false)
  createdAt        Int
  updatedAt        Int

  user   User   @relation(fields: [userId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

model UserActiveCountry {
  id        Int @id @default(autoincrement())
  userId    Int
  countryId Int
  createdAt Int

  user    User    @relation(fields: [userId], references: [id])
  country Country @relation(fields: [countryId], references: [id])

  @@unique([userId, countryId])
  @@index([userId])
  @@index([countryId])
}

model SettingAuditLog {
  id        Int     @id @default(autoincrement())
  userId    Int
  key       String
  oldValue  String?
  newValue  String
  createdAt Int

  user User @relation(fields: [userId], references: [id])

  @@index([key])
  @@index([userId])
}

model Friendship {
  id        Int    @id @default(autoincrement())
  userId    Int    // User who sent the request
  friendId  Int    // User who received the request
  status    String // 'PENDING', 'ACCEPTED', 'DECLINED'
  createdAt Int    // Unix timestamp
  updatedAt Int    // Unix timestamp

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendFriendships", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
}

model Notification {
  id         Int     @id @default(autoincrement())
  userId     Int     // Recipient of the notification
  type       String  // 'FRIEND_REQUEST', 'FRIEND_ACCEPTED'
  fromUserId Int?    // User who triggered the notification
  message    String
  read       Boolean @default(false)
  createdAt  Int     // Unix timestamp

  user     User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser User? @relation("NotificationsFrom", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model ArtistConcert {
  id        Int     @id @default(autoincrement())
  artistId  Int
  concertId Int
  isPrimary Boolean @default(false)  // True for the headliner/main artist
  createdAt Int

  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  concert Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)

  @@unique([artistId, concertId])
  @@index([artistId])
  @@index([concertId])
  @@index([isPrimary])
}
