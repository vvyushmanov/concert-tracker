# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Type: 'sqlite' or 'mysql'
# This controls which database to use for both Prisma (Next.js) and Python scripts
DB_TYPE=mysql

# MySQL Configuration (when DB_TYPE=mysql)
# These values are used by both the MySQL container and the application
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=concerts
MYSQL_USER=concertuser
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# SQLite Configuration (when DB_TYPE=sqlite)
# Overrides default file:/app/data/concerts.db path
# SQLITE_DB_PATH=file:/path/to/your/concerts.db

# =============================================================================
# LAST.FM API CONFIGURATION
# =============================================================================

# Last.fm API Key (required for fetching concerts and artist data)
# Get your API key from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Last.fm Username (for fetching your personal top artists)
LASTFM_USER=your_lastfm_username

# Country codes to search for concerts (comma-separated ISO 3166-1 alpha-2 codes)
# Examples: us,gb,de,fr,es,it,nl,be,se,no,dk,fi,pl,cz,at,ch,ie,pt,gr,tr,ru,ua,ge
COUNTRY_CODES=ge,tr,fr,de,es

# Minimum playcount threshold for artists to be included
MIN_PLAYCOUNT=40

# =============================================================================
# FANART.TV API CONFIGURATION
# =============================================================================

# Fanart.tv API Key (required for fetching artist images)
# Get your free API key from: https://fanart.tv/get-an-api-key/
FANART_API_KEY=your_fanart_api_key_here

# =============================================================================
# PROXY CONFIGURATION (Optional)
# =============================================================================

# Webshare.io proxy download URL (for proxy rotation)
# Get from your dashboard at: https://proxy.webshare.io
# Format: https://proxy.webshare.io/api/v2/proxy/list/download/{token}/-/any/username/direct/-/
WEBSHARE_PROXY_URL=your_webshare_proxy_url_here
